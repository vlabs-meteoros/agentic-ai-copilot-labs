# Copy this file to .env (setup-windows.ps1 does it for you) and fill in the
# values your trainer gives you. Never commit .env to Git.

# Shared Microsoft Foundry (Azure AI services, multi-service) resource - Day 1 Lab 1
# The same resource also serves Azure OpenAI for Day 2 Lab 6, Azure Speech + Azure OpenAI for Day 4 Lab 11,
# Azure OpenAI with an image (vision) for Day 5 Lab 13, Azure OpenAI tool calling for Day 7 Lab 21, and Azure OpenAI for Day 8 Labs 22-23.
AZURE_AI_ENDPOINT=<https://your-resource-name.cognitiveservices.azure.com/>
AZURE_AI_KEY=<your-key>
AZURE_AI_REGION=<region, for example southeastasia>

# Azure OpenAI model deployment on that resource - Day 2 Lab 6, Day 4 Lab 11, Day 5 Lab 13, Day 7 Lab 21, Day 8 Labs 22-23
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Day 8 Lab 22: the Redis-compatible server (Garnet, started with day8\start-garnet.ps1) and the model the workers use
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=azure
# Optional: a local model with Ollama instead of Azure (LLM_PROVIDER=ollama)
# OLLAMA_MODEL=qwen2.5:1.5b

# Day 8 Lab 23: the shared MongoDB Atlas cluster (your trainer gives you MONGODB_URI) and your own name for the lab
MONGODB_URI=<mongodb+srv://user:password@cluster.xxxxx.mongodb.net/>
PARTICIPANT_ID=<your first name and VM number, for example asha07>

# Your own Neo4j AuraDB Free instance - Day 2 Lab 7 (values from the credentials file you download)
NEO4J_URI=<neo4j+s://xxxxxxxx.databases.neo4j.io>
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-aura-password>

# Optional: Pinecone API key (free Starter plan) - Day 2 Lab 5, Part 7
# PINECONE_API_KEY=<pcsk_...>

# Optional: Hugging Face token (free account) - only needed if downloads are rate limited
# HF_TOKEN=<hf_...>
